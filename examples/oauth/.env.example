# Host-owned adapter example: GHATD does not load .env or read these names.
# Copy to an ignored file in YOUR app; preserve any existing local configuration.
# Start with Google on localhost; use one public HTTPS origin for Apple/mobile.
OAUTH_ORIGIN=http://localhost:5173
OAUTH_NAMESPACE=your-service:development
COOKIE_DOMAIN=

# All fields empty -> your adapter passes nil for that provider.
# Any field set -> supply the complete provider; reject partial configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_PATH=

# Blank -> native handoff disabled. Parse an explicit list in your host.
MOBILE_OAUTH_REDIRECT_URIS=

# Apple/mobile session examples (replace the hostname and register callbacks):
# OAUTH_ORIGIN=https://your-tunnel-host.ngrok-free.app
# MOBILE_OAUTH_REDIRECT_URIS=com.example.yourapp:/oauth/callback
# APPLE_OAUTH_CLIENT_ID=com.example.yourapp.web
# APPLE_OAUTH_PRIVATE_KEY_PATH=/run/secrets/apple-sign-in.p8
# Compose derives these callback URLs from OAUTH_ORIGIN:
# https://your-tunnel-host.ngrok-free.app/api/v1/ams/oauth/google/callback
# https://your-tunnel-host.ngrok-free.app/api/v1/ams/oauth/apple/callback
# Client secrets and .p8 contents belong only in the backend's secret store.
