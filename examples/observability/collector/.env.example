# Use with the reference Compose base and Collector overlay; defaults use LGTM.
COLLECTOR_BACKEND_ENDPOINT=http://lgtm:4318
# Set a single Authorization header value through local secret injection.
# Do not paste an OTEL_EXPORTER_OTLP_HEADERS list here or commit credentials.
COLLECTOR_AUTHORIZATION=
COLLECTOR_SERVICE_NAMESPACE=example
COLLECTOR_ENVIRONMENT=local
COLLECTOR_SERVICE_NAME=example-collector
# Selfmetrics use the container's runtime HOSTNAME as the instance ID by default.
# Other deployment runtimes should inject COLLECTOR_INSTANCE_ID uniquely per replica.

# Only compose-local.yaml publishes these loopback-only diagnostic ports.
COLLECTOR_OTLP_HTTP_PORT=14318
COLLECTOR_OTLP_GRPC_PORT=14317
COLLECTOR_HEALTH_PORT=13134
COLLECTOR_MONITOR_PORT=9091
